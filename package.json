{
  "name": "code-comprehension-assessment",
  "version": "1.0.0",
  "description": "Analyses code changes and uses AI to generate targeted comprehension questions for viva voce or written assessments.",
  "main": "src/main.js",
  "packageManager": "pnpm@11.1.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "start": "node src/main.js",
    "prepare": "husky",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/github": "^9.1.1",
    "@actions/http-client": "^4.0.1",
    "mammoth": "^1.12.0",
    "minimatch": "^10.2.5",
    "unpdf": "^1.6.2"
  },
  "type": "module",
  "license": "MIT",
  "private": true,
  "pnpm": {
    "overrides": {
      "fast-uri": ">=3.1.2",
      "brace-expansion": ">=5.0.6"
    }
  },
  "lint-staged": {
    "!(docs-site)/**/*.js": [
      "eslint --fix --no-warn-ignored",
      "prettier --write"
    ],
    "!(docs-site)/**/*.{json,yml,yaml,md}": "prettier --write"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.1",
    "@commitlint/config-conventional": "^21.0.1",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.4",
    "prettier": "^3.8.3",
    "vitest": "^4.1.6"
  }
}
