{
  "cases": [
    {
      "name": "finds the GrillMyCode step and leaves the others",
      "inputs": [
        "api_key: ${{ secrets.OPENROUTER_API_KEY }}",
        "num_questions: 10"
      ],
      "steps": [
        {
          "uses": "NSCC-ITC-Assessment/GrillMyCode@v0",
          "with": "with",
          "inputs": [
            {
              "name": "api_key"
            },
            {
              "name": "num_questions"
            }
          ]
        }
      ]
    },
    {
      "name": "says where each name and value is",
      "inputs": [
        "starter_code: \"ask\" # a comment"
      ],
      "steps": [
        {
          "inputs": [
            {
              "name": "starter_code",
              "text": "starter_code",
              "valueText": "\"ask\"",
              "value": "ask"
            }
          ]
        }
      ]
    },
    {
      "name": "gives each value as the action receives it",
      "inputs": [
        "keep_comments: True",
        "num_questions: 20",
        "include_answers: \"True\"",
        "instructor_context: |",
        "  Lab 3",
        "  Loops",
        "base_sha:"
      ],
      "steps": [
        {
          "inputs": [
            {
              "value": "true"
            },
            {
              "value": "20"
            },
            {
              "value": "True"
            },
            {
              "value": "Lab 3\nLoops\n"
            },
            {
              "value": ""
            }
          ]
        }
      ]
    },
    {
      "name": "gives numbers as JavaScript writes them",
      "inputs": [
        "num_questions: 1.0",
        "ai_temperature: .5",
        "assignment_context_max_chars: 0x10",
        "codebase_context_max_chars: 1e3",
        "ai_retry_max_attempts: 007",
        "starter_questions_one_in: ~"
      ],
      "steps": [
        {
          "inputs": [
            {
              "value": "1"
            },
            {
              "value": "0.5"
            },
            {
              "value": "16"
            },
            {
              "value": "1000"
            },
            {
              "value": "7"
            },
            {
              "value": ""
            }
          ]
        }
      ]
    },
    {
      "name": "marks a value GitHub works out at run time",
      "inputs": [
        "num_questions: ${{ inputs.num_questions }}",
        "starter_code: ask"
      ],
      "steps": [
        {
          "inputs": [
            {
              "expression": true
            },
            {
              "expression": false
            }
          ]
        }
      ]
    },
    {
      "name": "gives no value for something an input cannot be",
      "inputs": [
        "submission_tags: [phase1, phase2]"
      ],
      "steps": [
        {
          "inputs": [
            {
              "name": "submission_tags",
              "value": null
            }
          ]
        }
      ]
    },
    {
      "name": "reads a step with no inputs",
      "text": "steps:\n  - uses: NSCC-ITC-Assessment/GrillMyCode@v0\n",
      "steps": [
        {
          "with": null,
          "inputs": []
        }
      ]
    },
    {
      "name": "accepts the action at any version and in any letter case",
      "text": "steps:\n  - uses: nscc-itc-assessment/grillmycode@v0.29.0\n  - uses: actions/checkout@v6\n  - uses: my-school/GrillMyCode@v0\n",
      "steps": [
        {
          "uses": "nscc-itc-assessment/grillmycode@v0.29.0"
        }
      ]
    },
    {
      "name": "reads the tag patterns of on:  push:   tags: [\"phase1\", \"phase2\"]",
      "inputs": [],
      "on": "on:\n  push:\n    tags: [\"phase1\", \"phase2\"]",
      "tagFilters": [
        "phase1",
        "phase2"
      ]
    },
    {
      "name": "reads the tag patterns of on:  push:   tags:    - submit/*",
      "inputs": [],
      "on": "on:\n  push:\n    tags:\n      - submit/*",
      "tagFilters": [
        "submit/*"
      ]
    },
    {
      "name": "reads the tag patterns of on:  push:   tags: final",
      "inputs": [],
      "on": "on:\n  push:\n    tags: final",
      "tagFilters": [
        "final"
      ]
    },
    {
      "name": "reads the tag patterns of on:  push:   branches: [main]",
      "inputs": [],
      "on": "on:\n  push:\n    branches: [main]",
      "tagFilters": null
    },
    {
      "name": "reads the tag patterns of on: push",
      "inputs": [],
      "on": "on: push",
      "tagFilters": null
    },
    {
      "name": "reads the tag patterns of on: [push, workflow_dispatch]",
      "inputs": [],
      "on": "on: [push, workflow_dispatch]",
      "tagFilters": null
    },
    {
      "name": "reads nothing from \"\"",
      "text": "",
      "steps": []
    },
    {
      "name": "reads nothing from \"just some text\"",
      "text": "just some text",
      "steps": []
    },
    {
      "name": "reads nothing from \"a: [1\\n b: {\"",
      "text": "a: [1\n b: {",
      "steps": []
    },
    {
      "name": "reads the workflow's name",
      "inputs": [],
      "on": "name: Lab 3\non: push",
      "workflowName": {
        "value": "Lab 3",
        "text": "Lab 3"
      }
    },
    {
      "name": "reads a quoted workflow name as GitHub does",
      "inputs": [],
      "on": "name: 'Lab 3: it''s quoted'\non: push",
      "workflowName": {
        "value": "Lab 3: it's quoted",
        "text": "'Lab 3: it''s quoted'"
      }
    },
    {
      "name": "reads no name from a workflow without one",
      "inputs": [],
      "workflowName": null
    },
    {
      "name": "reads no name from an empty one",
      "inputs": [],
      "on": "name:\non: push",
      "workflowName": null
    },
    {
      "name": "files a step with no question set under none",
      "inputs": [
        "api_key: ${{ secrets.OPENROUTER_API_KEY }}"
      ],
      "questionSets": [
        ""
      ]
    },
    {
      "name": "files a step under the question set it names, as a folder name",
      "inputs": [
        "api_key: ${{ secrets.OPENROUTER_API_KEY }}",
        "question_set: \"Lab 3: Checkout\""
      ],
      "questionSets": [
        "lab-3-checkout"
      ]
    },
    {
      "name": "files a step named GrillMyCode under no question set",
      "inputs": [
        "api_key: ${{ secrets.OPENROUTER_API_KEY }}",
        "question_set: GrillMyCode"
      ],
      "questionSets": [
        ""
      ]
    },
    {
      "name": "files a step under the workflow's name",
      "inputs": [
        "api_key: ${{ secrets.OPENROUTER_API_KEY }}",
        "question_set: ${{ github.workflow }}"
      ],
      "on": "name: Lab 3\non: push",
      "questionSets": [
        "lab-3"
      ]
    },
    {
      "name": "files a step of an unnamed workflow under its path",
      "inputs": [
        "api_key: ${{ secrets.OPENROUTER_API_KEY }}",
        "question_set: ${{github.workflow}}"
      ],
      "path": ".github/workflows/quiz.yml",
      "questionSets": [
        "github-workflows-quiz-yml"
      ]
    },
    {
      "name": "leaves out a question set the file does not say",
      "inputs": [
        "api_key: ${{ secrets.OPENROUTER_API_KEY }}",
        "question_set: ${{ inputs.set }}"
      ],
      "questionSets": []
    },
    {
      "name": "leaves out a question set that names no folder",
      "inputs": [
        "api_key: ${{ secrets.OPENROUTER_API_KEY }}",
        "question_set: \"!!!\""
      ],
      "questionSets": []
    },
    {
      "name": "files nothing from a file with no GrillMyCode step",
      "text": "jobs:\n  a:\n    steps:\n      - uses: actions/checkout@v6\n",
      "questionSets": []
    }
  ]
}
