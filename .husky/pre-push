#!/usr/bin/env sh

ZERO="0000000000000000000000000000000000000000"
DOCS_BUILD_NEEDED=0

while read local_ref local_sha remote_ref remote_sha; do
  # Prevent pushing directly to main (based on the destination ref, not local HEAD —
  # tools like peter-evans/create-pull-request push a feature branch while HEAD is on main)
  if [ "$remote_ref" = "refs/heads/main" ]; then
    echo "Direct push to main is not allowed."
    echo "Create a branch and open a pull request instead."
    exit 1
  fi

  # Flag if any pushed commits touch docs-site/
  if [ "$local_sha" != "$ZERO" ]; then
    if [ "$remote_sha" = "$ZERO" ]; then
      base=$(git merge-base "$local_sha" origin/main 2>/dev/null || git rev-list --max-parents=0 HEAD)
      range="$base..$local_sha"
    else
      range="$remote_sha..$local_sha"
    fi
    if git diff --name-only "$range" 2>/dev/null | grep -q "^docs-site/"; then
      DOCS_BUILD_NEEDED=1
    fi
  fi
done

if [ "$DOCS_BUILD_NEEDED" = "1" ]; then
  echo "docs-site changes detected — verifying build..."
  pnpm --filter docs-site build || { echo "docs-site build failed — push aborted."; exit 1; }
fi
