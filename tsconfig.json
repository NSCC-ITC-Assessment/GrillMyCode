// Type-checks the action's JavaScript as it stands: `pnpm typecheck`. Nothing
// is compiled, and the action still runs src/ directly. Types are written as
// JSDoc.
{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    // Off until every parameter in src/ has a type: a function with none is
    // unchecked, not an error. extensions/vscode/ already has it on.
    "noImplicitAny": false,
    // A caught error is read as `err.message` throughout.
    "useUnknownInCatchVariables": false,
    "target": "es2023",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": ["es2023"],
    "types": ["node"],
    "skipLibCheck": true,
    "resolveJsonModule": true
  },
  "include": ["src/**/*.js"]
}
